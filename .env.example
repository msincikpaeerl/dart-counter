# Copy to .env for local development. Never commit .env.
# Port the app listens on.
PORT=3000
# PostgreSQL connection string (docker compose overrides it for the app service).
DATABASE_URL=postgres://dart:dart@localhost:5432/dart
# Directory where uploaded files (player photos) are stored; a volume in Docker.
UPLOAD_DIR=./data/uploads
# Password of the PostgreSQL user, read by docker-compose.yml (default: dart).
POSTGRES_PASSWORD=dart
