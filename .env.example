# Copy to .env. Never commit .env.
# With Docker Compose, only the first four variables are used (the app and database
# connection settings are built from them). The last two are for running the app
# outside Docker (npm run dev).

# Port on which the app is published on the host.
PORT=3000
# PostgreSQL user, password and database name (used by the db service and the app).
POSTGRES_USER=dart
POSTGRES_PASSWORD=dart
POSTGRES_DB=dart

# Outside Docker only: PostgreSQL connection string.
DATABASE_URL=postgres://dart:dart@localhost:5432/dart
# Outside Docker only: directory for uploaded photos (a named volume in Docker).
UPLOAD_DIR=./data/uploads
